msgid "plugins.generic.pidManager.displayName"
msgstr "PID Manager"

msgid "plugins.generic.pidManager.description"
msgstr "Plugin for adding Persistent Identifiers (PIDs) to publications."

msgid "plugins.generic.pidManager.settings.title"
msgstr "Manage PIDs"

msgid "plugins.generic.pidManager.settings.description"
msgstr ""
"Use the following checkboxes to select which Persistent Identifiers (PIDs) can be added during the editorial "
"process and made visible in the article view. Ticking a box activates the corresponding PID type."

msgid "plugins.generic.pidManager.articleDetails.buttonShowAll.showAll"
msgstr "Show All"

msgid "plugins.generic.pidManager.articleDetails.buttonShowAll.minimise"
msgstr "Minimise"

msgid "plugins.generic.pidManager.searchPhrase.empty"
msgstr "Your search phrase returned empty."

# IGSN

msgid "plugins.generic.pidManager.igsn.settings.label"
msgstr "IGSN (International Generic Sample Number - www.igsn.org)"

msgid "plugins.generic.pidManager.igsn.label"
msgstr "International Generic Sample Number (IGSN)"

msgid "plugins.generic.pidManager.igsn.workflow.name"
msgstr "IGSN"

msgid "plugins.generic.pidManager.igsn.workflow.label"
msgstr "IGSN"

msgid "plugins.generic.pidManager.igsn.generalDescription"
msgstr ""
"The International Generic Sample Number (IGSN) is a unique, persistent, domain-agnostic identifier for material samples. "
"These samples can be any material from all disciplines. Learn more at www.igsn.org."

msgid "plugins.generic.pidManager.igsn.workflow.instructions"
msgstr ""
"You can add IGSNs by searching with a DOI or title in the fields below and selecting from autocomplete suggestions. "
"The greyed-out items in the search results are already added. Multiple IGSNs can be added at once. "
"The lower table displays the metadata that will appear in the article view and lets you edit it."

msgid "plugins.generic.pidManager.igsn.submission.instructions"
msgstr "Currently, IGSNs can only be set at a later stage in the editorial process. "
"Please contact the journal manager if you would like to add an IGSN to your publication."

msgid "plugins.generic.pidManager.igsn.addFromCsv.instructions"
msgstr ""
"You can add IGSNs in batch by pasting your list as a CSV to the text field below and click the \"Add\" button. "
"Your CSV structure must contain all fields, e.g. \"doi 1\",\"title 1\",\"creators 1\",\"publisher 1\",\"publicationYear 1\". "
"Please do not add a header, this will also be imported. "

msgid "plugins.generic.pidManager.igsn.addFromCsv.success"
msgstr "All lines are added to the list below."

msgid "plugins.generic.pidManager.igsn.addFromCsv.partialSuccess"
msgstr "The lines above are duplicates or have errors. Please review and try again."

msgid "plugins.generic.pidManager.igsn.addFromCsv.inputEmpty"
msgstr "You have not given any input. Please review and try again."

msgid "plugins.generic.pidManager.igsn.deleteAllLink"
msgstr "Delete all IGSNs listed"

msgid "plugins.generic.pidManager.igsn.deleteAllDialog.title"
msgstr "Delete all IGSNs listed"

msgid "plugins.generic.pidManager.igsn.deleteAllDialog.description"
msgstr "This will remove all IGSNs currently listed. You'll need to re-enter your IGSNs again if you continue."

msgid "plugins.generic.pidManager.igsn.downloadCsvLink"
msgstr "Download IGSNs as a CSV"

msgid "plugins.generic.pidManager.igsn.filter.placeholder"
msgstr "Filter IGSNs below"

msgid "plugins.generic.pidManager.igsn.workflow.empty"
msgstr "Yet, no IGSNs have been added to this publication."

msgid "plugins.generic.pidManager.igsn.workflow.table.pid"
msgstr "DOI"

msgid "plugins.generic.pidManager.igsn.workflow.table.title"
msgstr "Title"

msgid "plugins.generic.pidManager.igsn.workflow.table.creators"
msgstr "Creators"

msgid "plugins.generic.pidManager.igsn.workflow.table.publisher"
msgstr "Publisher"

msgid "plugins.generic.pidManager.igsn.workflow.table.publicationYear"
msgstr "Year"

msgid "plugins.generic.pidManager.igsn.searchPhraseDoi.placeholder"
msgstr "Type your DOI here, e.g. 10.12345/12.3456"

msgid "plugins.generic.pidManager.igsn.searchPhraseTitle.placeholder"
msgstr "Type your title here, e.g. Sediment core"

msgid "plugins.generic.pidManager.igsn.articleDetails.details"
msgstr "The following list shows the IGSNs linked to the publication."

# PIDINST

msgid "plugins.generic.pidManager.pidinst.settings.label"
msgstr "PIDINST (Persistent Identification of Instruments - www.pidinst.org)"

msgid "plugins.generic.pidManager.pidinst.label"
msgstr "Persistent Identification of Instruments (PIDINST)"

msgid "plugins.generic.pidManager.pidinst.workflow.name"
msgstr "PIDINST"

msgid "plugins.generic.pidManager.pidinst.workflow.label"
msgstr "PIDINST"

msgid "plugins.generic.pidManager.pidinst.generalDescription"
msgstr ""
"The Persistent Identifier for Instruments (PIDINST) is a globally unique identifier for measuring instruments in sciences. "
"These instruments can be from all disciplines. Learn more at www.pidinst.org."

msgid "plugins.generic.pidManager.pidinst.workflow.instructions"
msgstr ""
"You can add PIDINSTs by searching with a DOI or title in the fields below and selecting from autocomplete suggestions. "
"The greyed-out items in the search results are already added. Multiple PIDINSTs can be added at once. "
"The lower table displays the metadata that will appear in the article view and lets you edit it."

msgid "plugins.generic.pidManager.pidinst.submission.instructions"
msgstr "Currently, PIDINSTs can only be set at a later stage in the editorial process. "
"Please contact the journal manager if you would like to add a PIDINST to your publication."

msgid "plugins.generic.pidManager.pidinst.addFromCsv.instructions"
msgstr ""
"You can add PIDINSTs in batch by pasting your list as a CSV to the text field below and click the \"Add\" button. "
"Your CSV structure must contain all fields, e.g. \"doi 1\", \"title 1\", \"creators 1\", \"publisher 1\", \"publicationYear 1\". "
"Please do not add a header, this will also be imported. "

msgid "plugins.generic.pidManager.pidinst.addFromCsv.success"
msgstr "All lines are added to the list below."

msgid "plugins.generic.pidManager.pidinst.addFromCsv.partialSuccess"
msgstr "The lines above are duplicates or have errors. Please review and try again."

msgid "plugins.generic.pidManager.pidinst.addFromCsv.inputEmpty"
msgstr "You have not given any input. Please review and try again."

msgid "plugins.generic.pidManager.pidinst.deleteAllLink"
msgstr "Delete all PIDINSTs listed"

msgid "plugins.generic.pidManager.pidinst.deleteAllDialog.title"
msgstr "Delete all PIDINSTs listed"

msgid "plugins.generic.pidManager.pidinst.deleteAllDialog.description"
msgstr "This will remove all PIDINSTs currently listed. You'll need to re-enter your PIDINSTs again if you continue."

msgid "plugins.generic.pidManager.pidinst.downloadCsvLink"
msgstr "Download PIDINSTs as a CSV"

msgid "plugins.generic.pidManager.pidinst.filter.placeholder"
msgstr "Filter PIDINSTs below"

msgid "plugins.generic.pidManager.pidinst.workflow.empty"
msgstr "Currently, no PIDINSTs have been added to this publication."

msgid "plugins.generic.pidManager.pidinst.workflow.table.pid"
msgstr "DOI"

msgid "plugins.generic.pidManager.pidinst.workflow.table.title"
msgstr "Title"

msgid "plugins.generic.pidManager.pidinst.workflow.table.creators"
msgstr "Creators"

msgid "plugins.generic.pidManager.pidinst.workflow.table.publisher"
msgstr "Publisher"

msgid "plugins.generic.pidManager.pidinst.workflow.table.publicationYear"
msgstr "Year"

msgid "plugins.generic.pidManager.pidinst.searchPhraseDoi.placeholder"
msgstr "Type your DOI here, e.g. 10.12345/12.3456"

msgid "plugins.generic.pidManager.pidinst.searchPhraseTitle.placeholder"
msgstr "Type your title here, e.g. station"

msgid "plugins.generic.pidManager.pidinst.articleDetails.details"
msgstr "The following list shows the PIDINSTs linked to the publication."
